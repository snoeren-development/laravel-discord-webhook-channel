{
    "name": "snoeren-development/laravel-discord-webhook-channel",
    "description": "Send notifications to a Discord webhook.",
    "keywords": [
        "laravel",
        "notification",
        "driver",
        "discord",
        "webhook",
        "snoeren"
    ],
    "homepage": "https://github.com/snoeren-development/laravel-discord-webhook-channel",
    "license": "MIT",
    "authors": [
        {
            "name": "Snoeren Development",
            "email": "info@snoerendevelopment.nl"
        }
    ],
    "require": {
        "php": "^8.3",
        "guzzlehttp/guzzle": "^7.10",
        "illuminate/notifications": "^12.0 || ^13.0",
        "illuminate/support": "^12.0 || ^13.0"
    },
    "require-dev": {
        "larastan/larastan": "^3.13",
        "orchestra/testbench": "^10.0 || ^11.0",
        "phpunit/phpunit": "^12.5"
    },
    "autoload": {
        "psr-4": {
            "SnoerenDevelopment\\DiscordWebhook\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "SnoerenDevelopment\\DiscordWebhook\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": [
            "vendor/bin/phpunit",
            "vendor/bin/phpstan"
        ]
    },
    "config": {
        "sort-packages": true
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
